# 默认使用 Mock：无需密钥即可体验全部主流程
AI_PROVIDER=mock

# 开启真实 DeepSeek 时改为 deepseek，并填写密钥
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 世界自动推进间隔（秒）；Demo 可用“推进一刻”按钮立即触发
TICK_SECONDS=30
DATABASE_PATH=./data/inconnewt.db

# Web 对外端口；默认端口占用时可调整
WEB_PORT=8080

# 每位访客独立一个世界；只有活跃世界（页面开着）会被推进 tick
# 同时活跃世界数上限，超出后新访客先进入观察模式排队
MAX_ACTIVE_WORLDS=20
# 每个世界每天可用的真实 AI 调用次数，超出后当日自动回落 Mock
AI_DAILY_CALL_LIMIT=120
